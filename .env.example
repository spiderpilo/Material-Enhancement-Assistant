GOOGLE_GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# Neon Postgres
# Pooled connection (host contains "-pooler") used by the backend at runtime.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct connection used for restores and migrations.
DIRECT_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Backend auth (HS256 JWT). Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000

# Neon object storage (S3-compatible). Neon console -> Connect -> Storage -> .env.
# The bucket must be created with Visibility = Public (it cannot be changed later).
# Any other S3-compatible provider (R2, AWS S3, MinIO) also works.
S3_ENDPOINT_URL=https://<branch-id>.storage.<cell>.<region>.aws.neon.tech
S3_REGION=us-east-2
S3_BUCKET=course-contents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL for objects, no trailing slash. For Neon: <S3_ENDPOINT_URL>/<S3_BUCKET>
STORAGE_PUBLIC_URL=https://<branch-id>.storage.<cell>.<region>.aws.neon.tech/course-contents

# Legacy Supabase settings: only needed once, by backend/scripts/migrate_supabase_storage.py
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=course-contents

# Frontend to backend API
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
