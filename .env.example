# Copy to .env for local development. Never commit .env.
# Production values live in Render (backend service env) and GitHub
# (repository variables/secrets); see README.md "Deployment".
# Values must be unquoted when pasted into Render or GitHub.

# --- Backend: Gemini --------------------------------------------------------
GOOGLE_GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# --- Backend: Neon Postgres -------------------------------------------------
# Pooled connection (host contains "-pooler"). Used by the backend at runtime.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct connection. Used only by backend/database/migrate.py and restores,
# never by the running backend (pooled hosts break migration advisory locks).
DIRECT_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# --- Backend: auth (HS256 JWT) ----------------------------------------------
# At least 32 characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000

# --- Backend: Neon object storage (S3-compatible) ---------------------------
# Neon console -> Connect -> Storage -> .env. Create the bucket with
# Visibility = Public (cannot be changed later). R2, AWS S3, or MinIO also work.
S3_ENDPOINT_URL=https://<branch-id>.storage.<cell>.<region>.aws.neon.tech
S3_REGION=us-east-2
S3_BUCKET=course-contents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL for objects, no trailing slash: <S3_ENDPOINT_URL>/<S3_BUCKET>
STORAGE_PUBLIC_URL=https://<branch-id>.storage.<cell>.<region>.aws.neon.tech/course-contents

# --- Backend: CORS -----------------------------------------------------------
# Comma-separated browser origins allowed to call the API. Defaults to the local
# frontend when unset. Production: the Render frontend URL.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend ---------------------------------------------------------------
# Inlined into the browser bundle at build time. Production images get it from
# the GitHub repository variable NEXT_PUBLIC_API_BASE_URL.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
